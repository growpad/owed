# Owed: copy to .env and fill in. The same file works locally and on Vercel:
# paste the whole file into Vercel > Project > Environment Variables. Never commit .env.

# Neon Postgres + AI Gateway (project fragrant-dawn-36906060, us-east-2)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
NEON_AI_GATEWAY_BASE_URL=https://<branch>-api.ai.<region>.aws.neon.tech
NEON_AI_GATEWAY_TOKEN=<from neon env pull>
LLM_MODEL=gpt-5-mini

# AgentMail: Owed's own inbox that you CC
MAIL_PROVIDER=agentmail
AGENTMAIL_API_KEY=am_...
AGENTMAIL_INBOX=owed-agent@agentmail.to
OWNER_EMAILS=you@example.com
MY_NAME=Your Name

# Safety: hard cap on emails Owed sends
SEND_BUDGET=20

# Password for the app (any username). Applies locally too.
APP_PASSWORD=<long random string>

# Demo clock: an ask counts as quiet after this long. Real use: 5 days
STALL_AFTER="20 minutes"
# Optional
# SEND_ALLOWLIST=a@x.com,b@y.com          # Owed only drafts to these addresses
# LLM_BASE_URL=https://api.openai.com/v1  # instead of the Neon AI Gateway
# LLM_API_KEY=sk-...
# MAIL_PROVIDER=gmail                     # read your own sent Gmail instead; then set
# GOOGLE_CLIENT_ID=  GOOGLE_CLIENT_SECRET=  GOOGLE_REFRESH_TOKEN=   (npm run token)
