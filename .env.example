# --- Neon (console.neon.tech, project in AWS us-east-2) ---
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
NEON_AI_GATEWAY_BASE_URL=https://<branch-host>
NEON_AI_GATEWAY_TOKEN=nt_live_...
# Fallback if the gateway is not unlocked: any OpenAI-compatible endpoint
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
LLM_MODEL=gpt-5-mini

# --- Mail: "agentmail" (Owed's own inbox you CC, no Google setup) or "gmail" ---
MAIL_PROVIDER=agentmail
# console.agentmail.to -> API Keys; the inbox you CC on every ask
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=owed@agentmail.to
# Your address(es); Owed CCs you on every nudge it sends
OWNER_EMAILS=you@example.com
# Optional safety: Owed only drafts to these addresses (demo: the 3 seed counterparts)
SEND_ALLOWLIST=
# Optional: hard cap on emails Owed may ever send from this database (free AgentMail plans are small)
SEND_BUDGET=

# --- Google, only if MAIL_PROVIDER=gmail (OAuth client type: Desktop app) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Printed by `npm run token` after you sign in as the demo Gmail
GOOGLE_REFRESH_TOKEN=

# --- Demo ---
MY_NAME=Joydip
# Demo clock. Use "5 days" in real life.
STALL_AFTER=20 minutes
# OWED_FAKE=1 runs with in-memory Gmail, LLM and Postgres (UI work only)
